html, body, p {
    margin: 0;
    padding: 0;
}
html {
    box-sizing: border-box;
}
*, *::before, *::after {
    box-sizing: inherit;
}
body {
    font-family: Verdana;
    font-size: 16px;
    color: #000000;
    font-weight: normal;
    text-decoration: none;
}

header h1, header h, header nav a {
    font-size: inherit;
    color: inherit;
    font-weight: inherit;
    text-decoration: inherit;
}
header, main, footer {
    display: flex;
}

main {
    flex-direction: row;
    padding: 15px;
}

footer {
    flex-direction: column;
}

header {
    flex-direction: row;
    padding: 30px;
    align-items: center;
}

header h1 {
   margin-left: 15px;
   font-weight: bold;
   font-size: 32px;
}

header nav
{
    display: flex;
        justify-content:flex-end;
    flex-grow: 2;
    align-self: flex-start;
    
}

header nav a {
    width: 75px;
    flex-shrink: 0;
}

article {
    margin: 15px;
    width: 100%;
    border: 2px solid black;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}
article h2{
  font-weight: normal;
  height: 50px;
  width: 50%;
  font-size: 1.5em;
  display: flex;
  justify-content: center;
  align-items: center;
  align-self: flex-end;
  margin: 0; 
  background-color: lightgray; 
  border-left: 2px solid black;
  border-bottom: 2px solid black; 
}

p {
    text-align: justify;
    padding: 15px;
    margin: 0;
}

footer {
    height: 100px;
    background-color:#d3d3d3;
    border-top: 2px solid black;
    margin-top:15px;
    display:flex;
    align-items: center;
    justify-content: center;
}

.bold {
    font-weight: bold;
}
html, body {
  height: 100%;
}
body {
  display: flex;
  flex-direction: column;
}
.content {
  flex: 1 0 auto;
}
.footer {
  flex-shrink: 0;
  
}

.hamburger {
    display: none; 

}

@media all and (max-width: 900px) {
		main {
				flex-wrap: wrap;
		 }

    .title {
        display: none; 
    }
    header nav {
        display: none;
    }

    .hamburger {
        display:block;
        margin-left: auto;   
     
		}
}
